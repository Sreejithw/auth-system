# =============================================================================
# Frontend environment
#
# VITE_API_URL is only a local-development fallback. Production containers
# receive API_URL at RUNTIME and generate /config.json before nginx starts:
#
#   * Local dev: copy this file to `.env`; `npm run dev` uses it if
#     public/config.json is unavailable.
#   * Docker/prod:
#       docker run -e API_URL=https://api.example.com auth-frontend
#     The same image digest can therefore be promoted between environments.
# =============================================================================

# Base URL of the backend API. The SPA sends all requests here with
# credentials (cookies) included.
VITE_API_URL=http://localhost:4000
