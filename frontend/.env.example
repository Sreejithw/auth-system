# =============================================================================
# Frontend environment
#
# Vite only exposes variables prefixed with `VITE_`, and it INLINES them at
# BUILD time. That means VITE_API_URL is a BUILD-TIME value, not a runtime one:
#
#   * Local dev:   copy this file to `.env`; `npm run dev` reads it live.
#   * Docker/prod: pass it as a build arg — it is baked into the static bundle:
#       docker build --build-arg VITE_API_URL=https://api.example.com -t auth-frontend ./frontend
#     Changing the API URL after build requires REBUILDING the image.
# =============================================================================

# Base URL of the backend API. The SPA sends all requests here with
# credentials (cookies) included.
VITE_API_URL=http://localhost:4000
