# =============================================================================
# Backend environment (RUNTIME variables)
#
# All variables below are read at RUNTIME by the zod-validated loader in
# src/config/env.ts (the server fails fast at boot if any are missing/invalid).
# In production these are injected by the platform / container env — do NOT
# bake secrets into the image. Locally, copy this file to `.env`.
#
# The Docker container reads these from the ambient environment; node-pg-migrate
# also reads DATABASE_URL from the environment when it runs on deploy.
# =============================================================================

# ---- Runtime ----
# development | test | production. When set to `production`, cookies become
# `Secure` and HSTS is enabled (see middleware/session.ts, csrf.ts, security.ts).
NODE_ENV=development

# API port. The container EXPOSEs 4000; keep this aligned if you change it.
PORT=4000

# Origin allowed by CORS (the frontend origin). Credentials (cookies) are
# enabled, so this must be the exact scheme+host+port of the frontend.
# Dev: http://localhost:5173   Prod: https://your-frontend-domain
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Postgres connection string. Used by the app AND by `npm run migrate` /
# the container entrypoint (node-pg-migrate up).
# Local dev matches the docker-compose Postgres service credentials.
DATABASE_URL=postgres://authuser:authpass@localhost:5432/authdb

# ---- Secrets (min 32 chars each; use DIFFERENT values; never commit real ones) ----
# Generate a strong value in PowerShell with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
CSRF_SECRET=change-me-to-a-different-long-random-string

# ---- Feature flags (optional; server-side only) ----
# Disabled by default so local boot and authentication never require Flipt.
FLIPT_ENABLED=false
FLIPT_URL=http://localhost:8080
FLIPT_NAMESPACE=auth-system
# Optional client token. Never expose this value to the frontend.
# FLIPT_TOKEN=
